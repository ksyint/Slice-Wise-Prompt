{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source volume question",
  "type": "object",
  "required": [
    "patient_id",
    "volume",
    "mask",
    "question",
    "answer",
    "closed"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string"
    },
    "closed": {
      "type": "boolean"
    },
    "volume": {
      "type": "string"
    },
    "mask": {
      "type": "string"
    },
    "mask_labels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "additionalProperties": true
}
